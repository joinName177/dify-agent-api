# Copy to .env.local and inject real values. Never commit .env.local.
POSTGRES_DB=dify_agent
POSTGRES_USER=dify_agent
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DIFY_AGENT_ENVIRONMENT=development
DIFY_AGENT_HTTP_ADDRESS=:8080
# When running the API container on the Compose network, use host `postgres`.
DIFY_AGENT_DATABASE_URL=
DIFY_AGENT_DATABASE_MIN_CONNS=2
DIFY_AGENT_DATABASE_MAX_CONNS=10
DIFY_AGENT_BOOTSTRAP_ADMIN_EMAIL=
DIFY_AGENT_BOOTSTRAP_ADMIN_PASSWORD=
DIFY_AGENT_ACCESS_TOKEN_TTL=15m
DIFY_AGENT_REFRESH_TOKEN_TTL=168h
# Optional outside production; production must provide an HTTPS OTLP/HTTP traces endpoint.
DIFY_AGENT_OTEL_EXPORTER_OTLP_ENDPOINT=
DIFY_AGENT_CORS_ALLOWED_ORIGINS=http://localhost:3000
DIFY_AGENT_RELEASE_ID=dev
DIFY_AGENT_BUILD_COMMIT=dirty
