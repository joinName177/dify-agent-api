{
  "$schema": "./architecture-profile.schema.json",
  "project": "dify-agent-api",
  "owner": "@joinName177",
  "runtime": {
    "language": "go",
    "version": "1.26.5",
    "entrypoint": "cmd/api",
    "artifact": "linux-container"
  },
  "database": {
    "engine": "postgresql",
    "majorVersion": 17,
    "migrationToolVersion": "v4.19.1"
  },
  "modules": ["agent", "user"],
  "openapi": {
    "contractId": "dify-agent-api/v1",
    "artifact": "api/openapi/v1/openapi.yaml",
    "digestFile": "api/openapi/v1/openapi.sha256",
    "sha256": "f2600bf399e8de1cf8b54bc5b211cdf471284461950a1f51a93aeea9befcd571"
  },
  "authentication": {
    "strategy": "local-password",
    "passwordHash": "argon2id",
    "accessToken": "opaque-memory",
    "refreshToken": "opaque-secure-http-only-cookie"
  },
  "dataClassifications": ["credentials", "authentication-secrets", "personal-data", "operational-metadata"],
  "targets": {
    "verify": { "owner": "@joinName177", "command": "make verify" },
    "serve": { "owner": "@joinName177", "command": "make build" },
    "migrate": { "owner": "@joinName177", "command": "make migrate-up" }
  }
}
