GO_IMAGE := golang:1.26.5-alpine3.23@sha256:622e56dbc11a8cfe87cafa2331e9a201877271cbff918af53d3be315f3da88cc
RACE_GO_IMAGE := golang:1.26.5-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651
OAPI_CODEGEN_VERSION := v2.6.0
MIGRATE_IMAGE := migrate/migrate:v4.19.1@sha256:cc4ad8e19d66791e3689405d9a028ce6e9614f32032db14acda1469f7201d6e4
STATICCHECK_VERSION := v0.7.0
GOVULNCHECK_VERSION := v1.6.0

.PHONY: generate digest tidy fmt test race vet staticcheck govulncheck build check e2e migrate-up migrate-down db-up db-down

generate:
	docker run --rm -v "$(CURDIR):/src" -w /src $(GO_IMAGE) sh -c 'go run github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@$(OAPI_CODEGEN_VERSION) -config api/openapi/v1/oapi-codegen.yaml api/openapi/v1/openapi.yaml'
	$(MAKE) digest

digest:
	shasum -a 256 api/openapi/v1/openapi.yaml | awk '{print $$1}' > api/openapi/v1/openapi.sha256
	awk '{print "// Code generated by make digest; DO NOT EDIT.\npackage openapiv1\n\nconst ContractSHA256 = \"" $$1 "\""}' api/openapi/v1/openapi.sha256 > generated/openapi/v1/digest.gen.go

tidy:
	docker run --rm -v "$(CURDIR):/src" -w /src $(GO_IMAGE) go mod tidy

fmt:
	docker run --rm -v "$(CURDIR):/src" -w /src $(GO_IMAGE) gofmt -w cmd internal generated

test:
	docker run --rm -v "$(CURDIR):/src" -w /src $(GO_IMAGE) go test ./...

race:
	docker run --rm -v "$(CURDIR):/src" -w /src $(RACE_GO_IMAGE) go test -race ./...

vet:
	docker run --rm -v "$(CURDIR):/src" -w /src $(GO_IMAGE) go vet ./...

staticcheck:
	docker run --rm -v "$(CURDIR):/src" -w /src $(GO_IMAGE) go run honnef.co/go/tools/cmd/staticcheck@$(STATICCHECK_VERSION) ./...

govulncheck:
	docker run --rm -v "$(CURDIR):/src" -w /src $(GO_IMAGE) go run golang.org/x/vuln/cmd/govulncheck@$(GOVULNCHECK_VERSION) ./...

build:
	docker build --sbom=true --provenance=mode=max -t dify-agent-api:dev .

check: generate tidy fmt vet staticcheck govulncheck test race build
	git diff --exit-code -- generated api/openapi/v1/openapi.sha256 go.mod go.sum

e2e:
	BASE_URL=$${BASE_URL:-http://localhost:18080/api/v1} ADMIN_EMAIL="$${DIFY_AGENT_BOOTSTRAP_ADMIN_EMAIL}" ADMIN_PASSWORD="$${DIFY_AGENT_BOOTSTRAP_ADMIN_PASSWORD}" ./test/e2e/auth-smoke.sh

db-up:
	docker compose --env-file .env.local up -d --wait postgres

db-down:
	docker compose --env-file .env.local down

migrate-up:
	docker run --rm --network dify-agent-api_default -v "$(CURDIR)/migrations:/migrations:ro" $(MIGRATE_IMAGE) -path=/migrations -database "postgres://$${POSTGRES_USER}:$${POSTGRES_PASSWORD}@postgres:5432/$${POSTGRES_DB}?sslmode=disable" up

migrate-down:
	docker run --rm --network dify-agent-api_default -v "$(CURDIR)/migrations:/migrations:ro" $(MIGRATE_IMAGE) -path=/migrations -database "postgres://$${POSTGRES_USER}:$${POSTGRES_PASSWORD}@postgres:5432/$${POSTGRES_DB}?sslmode=disable" down 1
