GO_IMAGE := golang:1.26.5-alpine3.23@sha256:622e56dbc11a8cfe87cafa2331e9a201877271cbff918af53d3be315f3da88cc
RACE_GO_IMAGE := golang:1.26.5-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651
OAPI_CODEGEN_VERSION := v2.6.0
MIGRATE_VERSION := v4.19.1
MIGRATE_IMAGE := migrate/migrate:$(MIGRATE_VERSION)@sha256:cc4ad8e19d66791e3689405d9a028ce6e9614f32032db14acda1469f7201d6e4
STATICCHECK_VERSION := v0.7.0
GOVULNCHECK_VERSION := v1.6.0
GITLEAKS_VERSION := v8.30.1
GITLEAKS_IMAGE := zricethezav/gitleaks:$(GITLEAKS_VERSION)@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
GOSEC_VERSION := v2.28.0
GO_LICENSES_VERSION := v2.0.1
GRYPE_VERSION := v0.116.0
GRYPE_IMAGE := anchore/grype:$(GRYPE_VERSION)@sha256:fd4ab4d1042b522c896e73bdf09ab8bf384fa417df99d6dd0d6e1008c7e7c821
GO_RUNNER ?= docker run --rm -e COMMIT_TITLE -e COMMIT_MESSAGE_FILE -v "$(CURDIR):/src" -w /src $(GO_IMAGE)
RACE_RUNNER ?= docker run --rm -v "$(CURDIR):/src" -w /src $(RACE_GO_IMAGE)
IMAGE_TAG ?= dify-agent-api:dev

.PHONY: governance-check ci-governance-check toolchain-check profile-check config-check architecture-check migration-version migration-manifest-check database-test-prepare http-contract-test prepare generate digest tidy fmt format-check mod-check generated-check build-contract-test commit-policy commit-policy-test staged-check hook-contract-test install-hooks secret-check secret-contract-test gosec license-report source-security-check container-security-check test race unit-race-test integration-test e2e-test vet staticcheck govulncheck static-analysis build container-build verify verify-steps check e2e migration-check migrate-up migrate-down db-up db-down

governance-check:
	$(GO_RUNNER) go test ./tools/governancecheck
	$(GO_RUNNER) go run ./tools/governancecheck

ci-governance-check:
	@set -e; for target in governance-check toolchain-check commit-policy-test; do \
		$(MAKE) "$$target"; \
	done
	@if [ -n "$${COMMIT_TITLE:-}" ]; then $(MAKE) commit-policy; fi

toolchain-check:
	$(GO_RUNNER) go test ./tools/toolchaincheck
	$(GO_RUNNER) go run ./tools/toolchaincheck

profile-check:
	$(GO_RUNNER) go test ./tools/architecturecheck
	$(GO_RUNNER) go run ./tools/architecturecheck

config-check:
	$(GO_RUNNER) go test ./internal/platform/config ./tools/configcheck
	$(GO_RUNNER) go run ./tools/configcheck

architecture-check:
	@set -e; for target in profile-check config-check; do \
		$(MAKE) "$$target"; \
	done

migration-manifest-check:
	$(GO_RUNNER) go test ./tools/migrationcheck
	$(GO_RUNNER) go run ./tools/migrationcheck

migration-version:
	$(GO_RUNNER) go run ./tools/migrationcheck -write-version generated/migrations/version.gen.go

database-test-prepare: migration-manifest-check
	$(GO_RUNNER) go run -tags postgres github.com/golang-migrate/migrate/v4/cmd/migrate@$(MIGRATE_VERSION) -path migrations -database "$${DIFY_AGENT_DATABASE_URL}" up

http-contract-test:
	$(GO_RUNNER) go test ./test/contract

prepare:
	@set -e; for target in generate migration-version tidy fmt; do \
		$(MAKE) "$$target"; \
	done

generate:
	$(GO_RUNNER) sh -c 'go run github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@$(OAPI_CODEGEN_VERSION) -config api/openapi/v1/oapi-codegen.yaml api/openapi/v1/openapi.yaml'
	$(MAKE) digest

digest:
	shasum -a 256 api/openapi/v1/openapi.yaml | awk '{print $$1}' > api/openapi/v1/openapi.sha256
	awk '{print "// Code generated by make digest; DO NOT EDIT.\npackage openapiv1\n\nconst ContractSHA256 = \"" $$1 "\""}' api/openapi/v1/openapi.sha256 > generated/openapi/v1/digest.gen.go

tidy:
	$(GO_RUNNER) go mod tidy

fmt:
	$(GO_RUNNER) gofmt -w cmd internal generated tools test

format-check:
	$(GO_RUNNER) sh -c 'unformatted="$$(gofmt -l cmd internal generated tools test)"; test -z "$$unformatted" || { printf "%s\n" "$$unformatted"; exit 1; }'

mod-check:
	$(GO_RUNNER) go mod tidy -diff

generated-check:
	GO_IMAGE='$(GO_IMAGE)' OAPI_CODEGEN_VERSION='$(OAPI_CODEGEN_VERSION)' OAPI_CODEGEN_RUNTIME='$(OAPI_CODEGEN_RUNTIME)' ./scripts/generated-check.sh

build-contract-test:
	GO_IMAGE='$(GO_IMAGE)' OAPI_CODEGEN_VERSION='$(OAPI_CODEGEN_VERSION)' ./scripts/build-contract-test.sh

commit-policy:
	$(GO_RUNNER) go run ./tools/commitpolicy

commit-policy-test:
	$(GO_RUNNER) go test ./tools/commitpolicy ./tools/stagedcheck

staged-check:
	GO_IMAGE='$(GO_IMAGE)' GITLEAKS_IMAGE='$(GITLEAKS_IMAGE)' ./scripts/staged-check.sh

hook-contract-test:
	GO_IMAGE='$(GO_IMAGE)' GITLEAKS_IMAGE='$(GITLEAKS_IMAGE)' ./scripts/hook-contract-test.sh

secret-check:
	GITLEAKS_IMAGE='$(GITLEAKS_IMAGE)' ./scripts/secret-check.sh

secret-contract-test:
	GITLEAKS_IMAGE='$(GITLEAKS_IMAGE)' ./scripts/secret-contract-test.sh

gosec:
	$(GO_RUNNER) go run github.com/securego/gosec/v2/cmd/gosec@$(GOSEC_VERSION) -quiet ./cmd/... ./internal/...

# Reporting only until the Owner approves a license allowlist as required by ADR 0003.
license-report:
	$(GO_RUNNER) go run github.com/google/go-licenses/v2@$(GO_LICENSES_VERSION) report ./cmd/api

source-security-check:
	@set -e; for target in govulncheck gosec secret-check secret-contract-test; do \
		$(MAKE) "$$target"; \
	done

container-security-check: container-build
	GRYPE_IMAGE='$(GRYPE_IMAGE)' IMAGE_TAG='$(IMAGE_TAG)' ./scripts/container-security-check.sh

install-hooks:
	git config core.hooksPath .githooks
	@printf '%s\n' 'Git hooks configured from .githooks/'

test:
	$(GO_RUNNER) go test ./...

race:
	$(RACE_RUNNER) go test -race ./...

unit-race-test:
	@set -e; for target in test race; do \
		$(MAKE) "$$target"; \
	done

integration-test: database-test-prepare
	$(GO_RUNNER) go test -tags integration ./internal/modules/user/infrastructure/postgres ./internal/platform/database

e2e-test: database-test-prepare
	$(GO_RUNNER) ./scripts/e2e-test.sh

vet:
	$(GO_RUNNER) go vet ./...

staticcheck:
	$(GO_RUNNER) sh -c 'go list ./... | grep -v "/generated/" | xargs go run honnef.co/go/tools/cmd/staticcheck@$(STATICCHECK_VERSION)'

govulncheck:
	$(GO_RUNNER) go run golang.org/x/vuln/cmd/govulncheck@$(GOVULNCHECK_VERSION) ./...

static-analysis:
	@set -e; for target in vet staticcheck govulncheck; do \
		$(MAKE) "$$target"; \
	done

build:
	docker build --sbom=true --provenance=mode=max -t $(IMAGE_TAG) .

container-build: build

verify:
	./scripts/verify-worktree.sh $(MAKE) verify-steps

verify-steps:
	@set -e; for target in governance-check toolchain-check architecture-check migration-manifest-check commit-policy-test format-check mod-check generated-check vet staticcheck source-security-check test race build; do \
		$(MAKE) "$$target"; \
	done

# Compatibility alias. Remove after all documented and automated callers use `make verify`.
check: verify

e2e: e2e-test

db-up:
	docker compose --env-file .env.local up -d --wait postgres

db-down:
	docker compose --env-file .env.local down

migrate-up:
	docker run --rm --network dify-agent-api_default -v "$(CURDIR)/migrations:/migrations:ro" $(MIGRATE_IMAGE) -path=/migrations -database "postgres://$${POSTGRES_USER}:$${POSTGRES_PASSWORD}@postgres:5432/$${POSTGRES_DB}?sslmode=disable" up

migration-check: database-test-prepare
	$(GO_RUNNER) go test -tags integration ./test/integration/migrations
	$(GO_RUNNER) go run -tags postgres github.com/golang-migrate/migrate/v4/cmd/migrate@$(MIGRATE_VERSION) -path migrations -database "$${DIFY_AGENT_DATABASE_URL}" down 1
	$(GO_RUNNER) go run -tags postgres github.com/golang-migrate/migrate/v4/cmd/migrate@$(MIGRATE_VERSION) -path migrations -database "$${DIFY_AGENT_DATABASE_URL}" up
	$(GO_RUNNER) go test -tags integration ./test/integration/migrations

migrate-down:
	docker run --rm --network dify-agent-api_default -v "$(CURDIR)/migrations:/migrations:ro" $(MIGRATE_IMAGE) -path=/migrations -database "postgres://$${POSTGRES_USER}:$${POSTGRES_PASSWORD}@postgres:5432/$${POSTGRES_DB}?sslmode=disable" down 1
